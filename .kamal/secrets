# resolved at deploy time via 1password cli (op signin required)
# `grep .` fails on empty output: a locked/confused 1password aborts the deploy instead of shipping empty credentials
DOCKER=$(kamal secrets fetch --adapter 1password --account problemli.1password.com --from PROBLEMLI/Docker Password)
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract Docker $DOCKER)
APP=$(kamal secrets fetch --adapter 1password --account problemli.1password.com --from PROBLEMLI/stuff LOGLI_SECRET)
LOGLI_SECRET=$(kamal secrets extract LOGLI_SECRET $APP)
# smtp item: peb5mhfy2vtp3a2oqn3ncspray — log@problem.li mailbox, shared with logli
SMTP_PASS=$(op item get peb5mhfy2vtp3a2oqn3ncspray --fields smtp_password --reveal | grep .)
